# MongoDB Connection String (MongoDB Atlas or local)
# Example format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/family_health_survey?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# Session Secret (At least 32 random characters for signing session cookies)
# In production, generate using: openssl rand -base64 32
SESSION_SECRET=your_random_secret_at_least_32_characters

# Initial Superadmin Credentials (for one-time setup via CLI: npm run seed:admin)
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=your_secure_admin_password_min_8_chars
